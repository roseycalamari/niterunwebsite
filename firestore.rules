rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMemberOfGroup(groupId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function isAdminOfGroup(groupId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == "admin";
    }

    function groupIsVerified(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId))
        && get(/databases/$(database)/documents/groups/$(groupId)).data.isVerified == true;
    }

    // Users: any user can read (unauthenticated reads needed for username
    // availability checks during registration). Owner can create/update own doc.
    // Other authenticated users can update social fields only.
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
                    && (request.auth.uid == userId
                        || request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['friends', 'friendCount', 'sessionsPlayed', 'mvpCount']));
      allow delete: if false;

      // Notifications: owner full access; any authenticated user can create (to send notifs)
      match /notifications/{notifId} {
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
        // Prevent spoofing: creator must be the signed-in user.
        // (Still allows app flows like friend requests/invites, but blocks impersonation.)
        allow create: if request.auth != null
                      && request.resource.data.fromUid == request.auth.uid;
      }

      // FCM device tokens: owner only. Used by Cloud Functions (Admin SDK) to send push.
      match /fcmTokens/{tokenId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Groups: anyone signed in can read; only admins can update group metadata,
    // EXCEPT new joiners (signed-in users) who may bump member counts by exactly +1.
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberCount == 1
        && request.resource.data.verifiedMemberCount == 1;

      // Admins can update anything on the group doc (name, banner, verification, etc.).
      // Non-admins can only join: they may change ONLY the count fields, and only by
      // increments of exactly +1, with `isVerified` recomputed accordingly.
      allow update: if isAdminOfGroup(groupId)
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['memberCount', 'verifiedMemberCount', 'isVerified'])
          && request.resource.data.memberCount == resource.data.memberCount + 1
          && request.resource.data.verifiedMemberCount == resource.data.verifiedMemberCount + 1
          && request.resource.data.isVerified == (request.resource.data.verifiedMemberCount >= 10)
        );
      allow delete: if false;

      // Membership: any member of the group can read all member docs (roster + @ mentions in sessions).
      match /members/{memberId} {
        allow read: if isMemberOfGroup(groupId);

        // Joining: user can create their own member doc.
        allow create: if isSignedIn() && memberId == request.auth.uid;

        // Updates: admins can update membership (e.g. role); members can only update their own snapshot fields.
        allow update: if isSignedIn()
          && (
            isAdminOfGroup(groupId)
            || (memberId == request.auth.uid
                && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['displayName', 'username', 'photoURL']))
          );

        allow delete: if false;
      }
    }

    // Account deletion flow — server (Admin SDK) only; clients never touch these
    match /accountDeletionRequests/{token} {
      allow read, write: if false;
    }
    match /accountDeletionPending/{userId} {
      allow read, write: if false;
    }

    // Error logs: clients can write (rate-limited client-side); only Admin SDK can read.
    // Helps capture production bugs without a third-party tool.
    match /errorLogs/{logId} {
      allow create: if request.auth == null
        || (request.auth != null
            && (request.resource.data.uid == request.auth.uid
                || request.resource.data.uid == null));
      allow read, update, delete: if false;
    }

    // Sessions: any authenticated user can read (needed for live session queries);
    // only the creator can create/update; no deletes
    match /sessions/{sessionId} {
      allow read: if request.auth != null;
      allow create: if isSignedIn()
                    && request.resource.data.creatorId == request.auth.uid
                    && request.resource.data.groupId is string
                    && groupIsVerified(request.resource.data.groupId)
                    && isAdminOfGroup(request.resource.data.groupId);
      allow update: if isSignedIn()
                    && resource.data.creatorId == request.auth.uid
                    && isAdminOfGroup(resource.data.groupId);
      allow delete: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
