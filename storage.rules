rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Avatars: path is avatars/{userId}.jpg — only that user can upload/overwrite
    match /avatars/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 2097152
                   && request.resource.contentType.matches('image/.*')
                   && fileName == request.auth.uid + '.jpg';
    }

    // Group banners: path is group-banners/{groupId}/banner.jpg — only group admins can upload/overwrite
    match /group-banners/{groupId}/banner.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5242880
                   && request.resource.contentType.matches('image/.*')
                   && firestore.exists(/databases/(default)/documents/groups/$(groupId)/members/$(request.auth.uid))
                   && firestore.get(/databases/(default)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == "admin";
    }
  }
}
